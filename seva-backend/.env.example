PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://your-server-ip:27017/sevadb

# Authentication
JWT_ACCESS_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Certificate verification module
VERIFY_BASE_URL=http://your-server-ip:3000/verify
CERT_ORG_CODE=SIF

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://your-server-ip:3000

# Cookie configuration for IP-based HTTP deployment (No HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
