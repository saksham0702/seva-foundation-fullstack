# ── Production Docker Compose Environment Template ────────────────────────────
# Copy to .env and adjust IP/domain names for your deployment.

# Frontend Build & Runtime
NEXT_PUBLIC_API_URL=http://your-server-ip:5000/api
NEXT_PUBLIC_IMAGE_URL=http://your-server-ip:5000
NEXT_PUBLIC_SITE_URL=http://your-server-ip:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
